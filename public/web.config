<?xml version="1.0" encoding="UTF-8"?>
<!--
  Letakkan di folder public\ (root situs IIS). Butuh modul "URL Rewrite" dan handler PHP (FastCGI).
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- buang garis miring di akhir URL -->
        <rule name="Laravel remove trailing slash" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <!-- semua yang bukan file/folder asli diteruskan ke index.php -->
        <rule name="Laravel front controller" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- unggahan foto profil dibatasi 2 MB di aplikasi; 10 MB di sini sudah cukup.
             Batas query string/URL dinaikkan karena DataTables mengirim banyak parameter kolom. -->
        <requestLimits maxAllowedContentLength="10485760"
                       maxQueryString="8192"
                       maxUrl="8192" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>